<Project Sdk="Microsoft.NET.Sdk.WindowsDesktop">

  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <TargetFrameworks>net462;net10.0-windows</TargetFrameworks>
    <UseWPF>true</UseWPF>
    <IsPackable>false</IsPackable>
    <GeminiPackageVersion Condition="'$(GeminiPackageVersion)' == ''">0.0.0-local</GeminiPackageVersion>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="GeminiWpf" Version="$(GeminiPackageVersion)" />
  </ItemGroup>

</Project>
